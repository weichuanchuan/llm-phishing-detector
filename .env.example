# Mail server configuration
MAIL_SERVER=
MAIL_USERNAME=
MAIL_PASSWORD=

# Path to the directory where incoming emails will be stored (Maildir format)
MAIL_SERVER_FS=./data/mailserver

# API key for Google Safe Browsing to check URLs for malicious content
GOOGLE_SAFE_BROWSING_API_KEY=

# API key for OpenRouter to access various AI models
OPENROUTER_API_KEY=

# Optional: path to a Chromium or Chrome executable. Leave empty to use Puppeteer's bundled browser.
PUPPETEER_EXECUTABLE_PATH=

# Web server port
PORT=3000
